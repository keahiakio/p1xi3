#!/usr/bin/env python3
"""
p1xi3 CLI (._.)
Global CLI entrypoint for the Pixel 7 Air-Gapped USB LLM Toolkit.
Enables running the TUI dashboard, host chat client, USB bridge,
and provisioning commands from any working directory.
"""

import os
import sys
import subprocess

# Resolve the canonical root directory of p1xi3 (handles symlinks)
PROJECT_DIR = os.path.dirname(os.path.realpath(__file__))
SCRIPTS_DIR = os.path.join(PROJECT_DIR, "scripts")

VERSION = "1.1.0"

# ANSI Colors
CYAN = "\033[1;36m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
BLUE = "\033[1;34m"
RED = "\033[1;31m"
BOLD = "\033[1m"
DIM = "\033[2m"
NC = "\033[0m"

HELP_TEXT = f"""{CYAN}p1xi3 (._.) - Pixel 7 Air-Gapped USB LLM Toolkit (v{VERSION}){NC}

{BOLD}USAGE:{NC}
  p1xi3 [command] [options]

{BOLD}CORE COMMANDS:{NC}
  {GREEN}p1xi3{NC}                 Launch the interactive TUI dashboard (default)
  {GREEN}p1xi3 tui{NC}             Launch the responsive Rust-style curses TUI
  {GREEN}p1xi3 chat{NC}            Launch the host USB streaming chat client (interactive REPL)
  {GREEN}p1xi3 status{NC}          Check ADB / Fastboot device status, carrier SKU & OEM lock
  {GREEN}p1xi3 bridge{NC}          Start the USB port forward bridge (tcp:11435 -> tcp:11434)
  {GREEN}p1xi3 switch{NC}          Interactive hot-switcher for installed models on device
  {GREEN}p1xi3 models{NC}          Browse, download, and push GGUF models to device
  {GREEN}p1xi3 update{NC}          Check upstream model updates & push to airgapped device
  {GREEN}p1xi3 provision{NC}       Provision Termux and native 16KB-aligned llama-server
  {GREEN}p1xi3 harden{NC}          Run air-gap security hardening checklist (use {DIM}--stock{NC} for stock Android)
  {GREEN}p1xi3 flash{NC}           View GrapheneOS flashing guide (panther)
  {GREEN}p1xi3 wizard{NC}          Launch CLI fallback setup wizard

{BOLD}GLOBAL MANAGEMENT:{NC}
  {GREEN}p1xi3 link{NC}            Install global symlink (~/.local/bin/p1xi3 and /usr/local/bin)
  {GREEN}p1xi3 unlink{NC}          Remove global symlinks
  {GREEN}p1xi3 credits{NC}         View acknowledgments for upstream projects & models
  {GREEN}p1xi3 version{NC}         Display p1xi3 version information
  {GREEN}p1xi3 help{NC}            Show this help reference

{BOLD}EXAMPLES:{NC}
  p1xi3                      # Open full TUI dashboard
  p1xi3 chat                 # Quick chat with phone's local LLM
  p1xi3 status               # Quick phone connection and telemetry check
  p1xi3 switch               # Hot-swap between installed models
  p1xi3 link                 # Enable 'p1xi3' command anywhere in terminal
"""

def cmd_link():
    """Installs symlinks so p1xi3 is globally executable from any directory."""
    print(f"{BLUE}[*] Configuring global executable symlinks for p1xi3...{NC}")
    target_bin = os.path.realpath(__file__)
    user_bin = os.path.expanduser("~/.local/bin")
    os.makedirs(user_bin, exist_ok=True)
    user_link = os.path.join(user_bin, "p1xi3")

    success = False
    try:
        if os.path.islink(user_link) or os.path.exists(user_link):
            os.remove(user_link)
        os.symlink(target_bin, user_link)
        print(f"{GREEN}(^_^) [ok] Created user symlink:{NC} {user_link}")
        success = True
    except Exception as e:
        print(f"{RED}[!] Failed to create user symlink in {user_bin}: {e}{NC}")

    # Check /usr/local/bin
    sys_link = "/usr/local/bin/p1xi3"
    try:
        if os.access("/usr/local/bin", os.W_OK):
            if os.path.islink(sys_link) or os.path.exists(sys_link):
                os.remove(sys_link)
            os.symlink(target_bin, sys_link)
            print(f"{GREEN}(^_^) [ok] Created system symlink:{NC} {sys_link}")
    except Exception:
        pass

    # Check PATH
    current_path = os.environ.get("PATH", "")
    if user_bin not in current_path.split(os.pathsep):
        print(f"\n{YELLOW}Note:{NC} {user_bin} is not in your $PATH.")
        print("Add it to your shell configuration (e.g. ~/.bashrc or ~/.zshrc):")
        print(f"  export PATH=\"{user_bin}:$PATH\"")
    else:
        print(f"\n{GREEN}{BOLD}p1xi3 is now globally executable!{NC} Type {CYAN}p1xi3{NC} from any directory.\n")

