def cmd_unlink():
    """Removes global symlinks."""
    user_link = os.path.expanduser("~/.local/bin/p1xi3")
    sys_link = "/usr/local/bin/p1xi3"
    removed = 0
    for link_path in [user_link, sys_link]:
        if os.path.islink(link_path) or os.path.exists(link_path):
            try:
                os.remove(link_path)
                print(f"{GREEN}(^_^) [ok] Removed symlink:{NC} {link_path}")
                removed += 1
            except Exception as e:
                print(f"{RED}[!] Error removing {link_path}: {e}{NC}")
    if removed == 0:
        print("No existing global p1xi3 symlinks were found.")

def run_script(script_name, args=None):
    """Executes a helper script from the scripts directory."""
    script_path = os.path.join(SCRIPTS_DIR, script_name)
    if not os.path.exists(script_path):
        print(f"{RED}Error:{NC} Script not found at {script_path}")
        sys.exit(1)
    cmd = ["bash", script_path] + (args or [])
    return subprocess.call(cmd)

def main():
    if len(sys.argv) < 2:
        # Default behavior: Launch TUI dashboard
        sys.path.insert(0, PROJECT_DIR)
        import tui
        try:
            tui.main()
        except KeyboardInterrupt:
            print("\np1xi3 session closed.\n")
        return

    subcmd = sys.argv[1].lower()

    if subcmd in ["help", "--help", "-h"]:
        print(HELP_TEXT)
    elif subcmd in ["version", "--version", "-v"]:
        print(f"p1xi3 version {VERSION} (._.)")
    elif subcmd in ["tui"]:
        sys.path.insert(0, PROJECT_DIR)
        import tui
        try:
            tui.main()
        except KeyboardInterrupt:
            print("\np1xi3 session closed.\n")
    elif subcmd in ["chat", "client", "repl"]:
        client_path = os.path.join(PROJECT_DIR, "client.py")
        subprocess.call([sys.executable, client_path] + sys.argv[2:])
    elif subcmd in ["status", "check"]:
        sys.exit(run_script("01_check_device.sh", sys.argv[2:]))
    elif subcmd in ["flash", "flashing"]:
        sys.exit(run_script("02_flash_guide.sh", sys.argv[2:]))
    elif subcmd in ["harden", "airgap"]:
        if "--stock" in sys.argv:
            sys.exit(run_script("03_stock_harden.sh", [a for a in sys.argv[2:] if a != "--stock"]))
        else:
            sys.exit(run_script("03_airgap_harden.sh", sys.argv[2:]))
    elif subcmd in ["provision", "setup-phone"]:
        sys.exit(run_script("04_provision_device.sh", sys.argv[2:]))
    elif subcmd in ["models", "push", "download"]:
        sys.exit(run_script("05_push_model.sh", sys.argv[2:]))
    elif subcmd in ["update", "check-update", "check-updates", "upgrade"]:
        sys.exit(run_script("08_update_models.sh", sys.argv[2:]))
    elif subcmd in ["bridge", "forward"]:
        sys.exit(run_script("06_start_bridge.sh", sys.argv[2:]))
    elif subcmd in ["switch", "swap"]:
        sys.exit(run_script("07_switch_model.sh", sys.argv[2:]))
    elif subcmd in ["wizard"]:
        wizard_path = os.path.join(PROJECT_DIR, "wizard.py")
        subprocess.call([sys.executable, wizard_path] + sys.argv[2:])
    elif subcmd in ["link", "install-global", "enable-global"]:
        cmd_link()
    elif subcmd in ["unlink", "uninstall-global", "disable-global"]:
        cmd_unlink()
    elif subcmd in ["credits", "credit", "thanks", "acknowledgments", "about"]:
        cmd_credits()
    else:
        print(f"{RED}Unknown command:{NC} '{subcmd}'")
        print("Run 'p1xi3 --help' for a list of available commands.")
        sys.exit(1)

if __name__ == "__main__":
    main()
